<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Static Variables -->
    <Color x:Key="BrandRed">#FF0000</Color>

    <!-- Fallback theme resources used at compile time -->
    <SolidColorBrush x:Key="ButtonBackgroundColor" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonForegroundColor" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ButtonFocusedColor" Color="#333"/>

    <!-- Theme variables -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- Light theme -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="ThemeBackgroundColor" Color="#DDD"/>
            <SolidColorBrush x:Key="ThemeSecondaryBackgroundColor" Color="#CCC"/>
            <SolidColorBrush x:Key="ThemeLightColor" Color="#BBB"/>

            <!-- Button -->
            <SolidColorBrush x:Key="ButtonBackgroundColor" Color="#FFF"/>
            <SolidColorBrush x:Key="ButtonForegroundColor" Color="#22000000"/>
            <SolidColorBrush x:Key="ButtonFocusedColor" Color="#CCC"/>

            <!-- Settings page -->
            <SolidColorBrush x:Key="SettingsGroupBackgroundColor" Color="#AAFFFFFF"/>
            <SolidColorBrush x:Key="SettingsSeparatorColor" Color="Transparent"/>

        </ResourceDictionary>

        <!-- Dark theme -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="ThemeBackgroundColor" Color="#040404"/>
            <SolidColorBrush x:Key="ThemeSecondaryBackgroundColor" Color="#080808"/>
            <SolidColorBrush x:Key="ThemeLightColor" Color="#111"/>

            <!-- Button -->
            <SolidColorBrush x:Key="ButtonBackgroundColor" Color="Transparent"/>
            <SolidColorBrush x:Key="ButtonForegroundColor" Color="#44FFFFFF"/>
            <SolidColorBrush x:Key="ButtonFocusedColor" Color="#333"/>

            <!-- Settings page -->
            <SolidColorBrush x:Key="SettingsGroupBackgroundColor" Color="#AA000000"/>
            <SolidColorBrush x:Key="SettingsSeparatorColor" Color="Transparent"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>