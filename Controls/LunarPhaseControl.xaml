<UserControl
    x:Class="moonlight_xbox_dx.LunarPhaseControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="160" Height="160">
    <Grid Width="160" Height="160" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleXform" ScaleX="0.6" ScaleY="0.6"/>
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OrbitStates">
                <VisualState x:Name="NotOrbiting"/>
                <VisualState x:Name="Orbiting">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="OrbitRotation"
                            Storyboard.TargetProperty="Angle"
                            From="0" To="360"
                            Duration="0:0:2"
                            RepeatBehavior="Forever"/>

                        <!-- Hide dot while it's behind the moon (66° arc on each side).
                             Moon r=76, orbit r=83 → arcsin(76/83)≈66° → 0.37s into 2s cycle. -->
                        <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="OrbitDot"
                            Storyboard.TargetProperty="Opacity"
                            Duration="0:0:2"
                            RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame   KeyTime="0:0:0.00" Value="1"/>
                            <LinearDoubleKeyFrame   KeyTime="0:0:0.35" Value="1"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.37" Value="0"/>
                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.63" Value="1"/>
                            <LinearDoubleKeyFrame   KeyTime="0:0:2.00" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>

                        <!-- Scale pulse: larger at front (top), smaller at back (bottom). -->
                        <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="OrbitDotScale"
                            Storyboard.TargetProperty="ScaleX"
                            Duration="0:0:2"
                            RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="1.3"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0.7"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.3"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="OrbitDotScale"
                            Storyboard.TargetProperty="ScaleY"
                            Duration="0:0:2"
                            RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="1.3"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0.7"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.3"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="0.6" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="0.6" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.0" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.0" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Crescent path: PathGeometry is assigned entirely in code-behind -->
        <Path x:Name="CrescentPath" Fill="White"/>

        <!-- White stroke ring -->
        <Ellipse x:Name="RingEllipse"
                 Width="152" Height="152"
                 Stroke="#bbFFFFFF" StrokeThickness="1"
                 Fill="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Lock overlay icon -->
        <Image x:Name="LockIcon"
               Source="ms-appx:///Assets/lock.svg"
               Width="32" Height="32"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Disconnected overlay icon -->
        <Image x:Name="DisconnectedIcon"
               Source="ms-appx:///Assets/disconnected.svg"
               Width="32" Height="32"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Orbit pivot at ring center -->
        <Canvas x:Name="OrbitCanvas"
                Width="0" Height="0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="80,80,0,0"
                Visibility="Collapsed">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="OrbitRotation" CenterX="0" CenterY="0"/>
            </Canvas.RenderTransform>
            <Ellipse x:Name="OrbitDot" Width="10" Height="10" Fill="White"
                     Canvas.Left="-5" Canvas.Top="-88"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="OrbitDotScale"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Grid>
</UserControl>
