<UserControl
    x:Class="moonlight_xbox_dx.LunarPhaseControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="160" Height="160">
    <Grid Width="160" Height="160" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleXform"/>
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OrbitStates">
                <VisualState x:Name="NotOrbiting"/>
                <VisualState x:Name="Orbiting">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="OrbitRotation"
                            Storyboard.TargetProperty="Angle"
                            From="0" To="360"
                            Duration="0:0:2"
                            RepeatBehavior="Forever"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Crescent path: PathGeometry is assigned entirely in code-behind -->
        <Path x:Name="CrescentPath" Fill="White"/>

        <!-- White stroke ring -->
        <Ellipse x:Name="RingEllipse"
                 Width="152" Height="152"
                 Stroke="White" StrokeThickness="2"
                 Fill="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Lock overlay icon -->
        <Image x:Name="LockIcon"
               Source="ms-appx:///Assets/lock.svg"
               Width="32" Height="32"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Disconnected overlay icon -->
        <Image x:Name="DisconnectedIcon"
               Source="ms-appx:///Assets/disconnected.svg"
               Width="32" Height="32"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Orbit pivot at ring center -->
        <Canvas x:Name="OrbitCanvas"
                Width="0" Height="0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="80,80,0,0"
                Visibility="Collapsed">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="OrbitRotation" CenterX="0" CenterY="0"/>
            </Canvas.RenderTransform>
            <Ellipse Width="10" Height="10" Fill="White"
                     Canvas.Left="-5" Canvas.Top="-88"/>
        </Canvas>
    </Grid>
</UserControl>
