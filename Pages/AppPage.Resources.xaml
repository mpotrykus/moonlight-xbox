<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx">

    <local:MultiplyConverter x:Key="MultiplyConverter" />
    <local:BlurPaddingConverter x:Key="BlurPaddingConverter" />
    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <local:WindowHeightConverter x:Key="WindowHeightConverter" />

    <!--Global-->
    <x:String x:Key="SharedAnimationDuration">0:0:0.125</x:String>
    
    <!--Background-->
    <x:Double x:Key="BackgroundBlurAmount">20</x:Double>
    <x:Double x:Key="BackgroundImageZoom">1.5</x:Double>
    <x:Double x:Key="BackgroundOverlayOpacity">0.1</x:Double>
    <Thickness x:Key="PageBackgroundOverscan">-150</Thickness>
  
    <!--Apps-->
    <x:Double x:Key="AppAspectRatio">0.66</x:Double>
    <x:Double x:Key="BlurAmount">16</x:Double>

    <x:Double x:Key="SelectedScale">1.0</x:Double>
    <x:Double x:Key="SelectedBlurScaleX">1.2</x:Double>
    <x:Double x:Key="SelectedBlurScaleY">1.12</x:Double>
    <x:Double x:Key="UnselectedScale">0.75</x:Double>
    <x:Double x:Key="GridScale">1.0</x:Double>
  
    <x:Double x:Key="SelectedBlurGlowOpacity">0.35</x:Double>
    <x:Double x:Key="UnselectedBlurGlowOpacity">0.0</x:Double>
  
    <x:Double x:Key="SelectedDesaturatorOpacity">0.0</x:Double>
    <x:Double x:Key="UnselectedDesaturatorOpacity">0.8</x:Double>

    <local:UniformThicknessConverter x:Key="UniformThicknessConverter" />
    <!-- Vertical fade brush for reflections: top fully opaque -> bottom transparent -->
    <LinearGradientBrush x:Key="VerticalReflectionFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#80FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ItemsPanel templates for list (horizontal) and grid (vertical) layouts -->
    <!-- Horizontal: use an ItemsStackPanel with horizontal orientation for true horizontal scrolling -->
    <ItemsPanelTemplate x:Key="HorizontalItemsPanelTemplate">
        <ItemsStackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <!-- Grid: use ItemsWrapGrid with Horizontal orientation so items wrap into rows (vertical scrolling) -->
    <ItemsPanelTemplate x:Key="GridItemsPanelTemplate">
        <ItemsWrapGrid Orientation="Horizontal"
                       Margin="0,75"
                       HorizontalAlignment="Center" VerticalAlignment="Top" />
    </ItemsPanelTemplate>

    <!-- Explicit Storyboards to control selected app overlay as a reliable fallback -->
    <Storyboard x:Key="ShowSelectedAppStoryboard">
        <DoubleAnimation Storyboard.TargetName="SelectedAppBox" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SharedAnimationDuration}" />
        <DoubleAnimation Storyboard.TargetName="SelectedAppText" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SharedAnimationDuration}" />
    </Storyboard>
    <Storyboard x:Key="HideSelectedAppStoryboard">
        <DoubleAnimation Storyboard.TargetName="SelectedAppBox" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource SharedAnimationDuration}" />
        <DoubleAnimation Storyboard.TargetName="SelectedAppText" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource SharedAnimationDuration}" />
    </Storyboard>

    <DataTemplate x:Key="AppItemTemplate">
        <Border
        Background="Transparent"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        RenderTransformOrigin="0.5,0.5">

            <Grid x:Name="ItemGrid" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                <local:AspectRatioBox x:Name="AppAspectRatioBox" Ratio="{StaticResource AppAspectRatio}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{Binding Source={StaticResource BlurAmount}, Converter={StaticResource BlurPaddingConverter}}">
                    <Grid>

                        <!-- Main Image -->
                        <Rectangle x:Name="AppImageRect" RadiusX="12" RadiusY="12" Opacity="1" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Image}" />
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Emboss (sheen overlay) -->
                        <Rectangle x:Name="Emboss" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Opacity="0">
                            <Rectangle.Fill>
                                <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/sheen.png" Opacity="1" />
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Play State -->
                        <Rectangle x:Name="Play" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Margin="60"
                                    Visibility="{Binding CurrentlyRunning, Converter={StaticResource BoolToVis}}">
                            <Rectangle.Fill>
                                <ImageBrush Stretch="Uniform" ImageSource="ms-appx:///Assets/Play1.png" />
                            </Rectangle.Fill>
                        </Rectangle>

                    </Grid>
                </local:AspectRatioBox>

                <!-- Reflection -->
                <Rectangle x:Name="AppImageReflectionRect" Opacity="0" IsHitTestVisible="False"
                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                           Height="150"
                           MinWidth="50"
                           Visibility="Collapsed">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="-1"/>
                            <TranslateTransform Y="270"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <ImageBrush x:Name="AppImageReflectionBrush" Stretch="Fill"
                            ImageSource="{Binding BlurredImage}" />
                    </Rectangle.Fill>
                </Rectangle>

            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="AppListViewItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource BaseListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent"
                          DataContext="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" MinHeight="50" MaxHeight="75"/>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="1*" MinHeight="70" MaxHeight="100"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="AppVisualRoot" Grid.Row="1" RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="5,0">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{StaticResource UnselectedScale}" ScaleY="{StaticResource UnselectedScale}"/>
                            </Grid.RenderTransform>

                            <Rectangle x:Name="AppImageBlurRect" Opacity="0" IsHitTestVisible="False"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        RenderTransformOrigin="0.5,0.5"
                                        RadiusX="12" RadiusY="12">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{StaticResource UnselectedScale}" ScaleY="{StaticResource UnselectedScale}"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Fill>
                                    <ImageBrush Stretch="Fill" ImageSource="{Binding GlowImage}" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <local:AspectRatioBox x:Name="AppAspectRatioBox" Ratio="{StaticResource AppAspectRatio}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Rectangle x:Name="AppImageRect" RadiusX="12" RadiusY="12" Opacity="1" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Image}" />
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Rectangle x:Name="Desaturator" Fill="#FF000000" Opacity="{StaticResource UnselectedDesaturatorOpacity}"
                                               RadiusX="12" RadiusY="12" IsHitTestVisible="False"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                    <Rectangle x:Name="Emboss" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Opacity="0">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/sheen.png" Opacity="1" />
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Rectangle x:Name="Play" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Margin="60"
                                               Visibility="{Binding CurrentlyRunning, Converter={StaticResource BoolToVis}}">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="Uniform" ImageSource="ms-appx:///Assets/Play1.png" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </local:AspectRatioBox>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="{StaticResource UnselectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="{StaticResource UnselectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>

                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="{StaticResource UnselectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="{StaticResource UnselectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>

                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource UnselectedBlurGlowOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource UnselectedDesaturatorOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="{StaticResource SelectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="{StaticResource SelectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>

                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="{StaticResource SelectedBlurScaleX}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="{StaticResource SelectedBlurScaleY}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>

                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource SelectedBlurGlowOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource SelectedDesaturatorOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected"/>
                                <VisualState x:Name="PressedSelected"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppGridViewItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource BaseListViewItem}">
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          DataContext="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" >
                        <Grid x:Name="AppVisualRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{StaticResource GridScale}" ScaleY="{StaticResource GridScale}"/>
                            </Grid.RenderTransform>

                            <!-- Glow rect: negative margin so it bleeds outside the image bounds -->
                            <Rectangle x:Name="AppImageBlurRect" Opacity="0" IsHitTestVisible="False"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Visibility="Collapsed"
                                       RadiusX="12" RadiusY="12">
                                <Rectangle.Fill>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding GlowImage}" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Image box: no extra margin, sits flush inside AppVisualRoot -->
                            <local:AspectRatioBox x:Name="AppAspectRatioBox" Ratio="{StaticResource AppAspectRatio}"
                                                  Height="400"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid>
                                    <Rectangle x:Name="AppImageRect" RadiusX="12" RadiusY="12" Opacity="1" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Image}" />
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Rectangle x:Name="Desaturator" Fill="#FF000000" Opacity="{StaticResource UnselectedDesaturatorOpacity}"
                                               RadiusX="12" RadiusY="12" IsHitTestVisible="False"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                    <Rectangle x:Name="Emboss" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Opacity="0">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="ms-appx:///Assets/sheen.png" Opacity="1" />
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Rectangle x:Name="Play" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Margin="60"
                                               Visibility="{Binding CurrentlyRunning, Converter={StaticResource BoolToVis}}">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="Uniform" ImageSource="ms-appx:///Assets/Play1.png" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </local:AspectRatioBox>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="{StaticResource GridScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="{StaticResource GridScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource UnselectedBlurGlowOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource UnselectedDesaturatorOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="{StaticResource GridScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppVisualRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="{StaticResource GridScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected"/>
                                <VisualState x:Name="PressedSelected"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Overlay behind everything -->
                        <Border x:Name="BackgroundOverlay"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.Background>
                                <SolidColorBrush x:Name="OverlayBrush" Color="#FF333333"/>
                            </Border.Background>
                        </Border>

                        <!-- Base background + content, with padding -->
                        <Border x:Name="BaseBackground"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>

                        <!-- Visual states -->
