<Page
    x:Class="moonlight_xbox_dx.HostSelectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ThemeBackgroundColor}"
    XYFocusKeyboardNavigation="Disabled"
    >
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:String x:Key="SharedAnimationDuration">0:0:0.125</x:String>
            <x:Double x:Key="HostSelectedScale">1.3</x:Double>
            <x:Double x:Key="HostUnselectedScale">1.0</x:Double>
            <x:Double x:Key="HostSelectedDesaturatorOpacity">0.0</x:Double>
            <x:Double x:Key="HostUnselectedDesaturatorOpacity">0.9</x:Double>

            <Style x:Key="HostGridViewItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid Background="Transparent">
                                <Grid x:Name="ItemRoot" RenderTransformOrigin="0.5,0.5" Margin="8,0">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="{StaticResource HostUnselectedScale}" ScaleY="{StaticResource HostUnselectedScale}"/>
                                    </Grid.RenderTransform>

                                    <ContentPresenter x:Name="contentPresenter"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Content="{TemplateBinding Content}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>

                                    <Rectangle x:Name="Desaturator"
                                               Fill="{ThemeResource ThemeBackgroundColor}"
                                               Opacity="{StaticResource HostUnselectedDesaturatorOpacity}"
                                               RadiusX="12"
                                               RadiusY="12"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                                </Grid>

                                <VisualStateManager.VisualStateGroups>

                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemRoot"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="{StaticResource HostUnselectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                                <DoubleAnimation Storyboard.TargetName="ItemRoot"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="{StaticResource HostUnselectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{StaticResource HostUnselectedDesaturatorOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver"/>
                                        <VisualState x:Name="Pressed"/>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ItemRoot"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="{StaticResource HostSelectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                                <DoubleAnimation Storyboard.TargetName="ItemRoot"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="{StaticResource HostSelectedScale}" Duration="{StaticResource SharedAnimationDuration}" EnableDependentAnimation="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{StaticResource HostSelectedDesaturatorOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected"/>
                                        <VisualState x:Name="PressedSelected"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

        <Grid Background="{ThemeResource ThemeBackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="75" />
                <RowDefinition Height="*" />
                <RowDefinition Height="75" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" VerticalAlignment="Center" Padding="30,8" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo2.gif" Margin="0,0,2,5" Width="24" Height="24"></Image>
                    <TextBlock VerticalAlignment="Center" Padding="12,0" FontFamily="Bahnschrift" CharacterSpacing="500" FontSize="14">MOONLIGHT</TextBlock>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,16" HorizontalAlignment="Stretch" TextAlignment="Center" >Select Host</TextBlock>
                <ListView Grid.Row="1"
                          Margin="0,12"
                          IsRightTapEnabled="True"
                          RightTapped="HostsGrid_RightTapped"
                          x:Name="HostsGrid"
                          ItemsSource="{x:Bind State.SavedHosts}"
                          IsItemClickEnabled="True"
                          ItemClick="GridView_ItemClick"
                          SelectionChanged="HostsGrid_SelectionChanged"
                          Loaded="HostsGrid_Loaded"
                          SizeChanged="HostsGrid_SizeChanged"
                          TabIndex="0"
                          SelectionMode="Single"
                          SelectedIndex="0"
                          ItemContainerStyle="{StaticResource HostGridViewItemContainerStyle}"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MoonlightHost" x:DefaultBindMode="OneWay">
                            <StackPanel>
                                <StackPanel Padding="16,0" VerticalAlignment="Center">
                                    <Canvas Width="216" Height="216">
                                        <Image Source="ms-appx:///Assets/desktop.svg" Width="200" Height="200" Canvas.Left="16" Canvas.Top="16" />
                                        <Image Source="ms-appx:///Assets/lock.svg" Visibility="{x:Bind NotPaired}" Width="96" Height="96" Canvas.Left="70" Canvas.Top="50" />
                                        <Image Source="ms-appx:///Assets/disconnected.svg" Visibility="{x:Bind NotConnected}" Width="96" Height="96" Canvas.Left="70" Canvas.Top="50" />
                                        <Grid Width="216" Height="216" Canvas.Left="0" Canvas.Top="0" Visibility="{x:Bind WolPollingVisibility}">
                                            <Rectangle Fill="#80000000" Width="216" Height="216" />
                                            <muxc:ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Canvas>
                                </StackPanel>
                                <muxc:ProgressBar IsIndeterminate="True" Visibility="{x:Bind WolPollingVisibility}"></muxc:ProgressBar>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0"
                        Padding="24,12"
                        CornerRadius="10"
                        Background="#BB000000">
                    <TextBlock FontFamily="Bahnschrift"
                               FontSize="12"
                               TextAlignment="Center"
                               Text="{Binding ElementName=HostsGrid, Path=SelectedItem.ComputerName}" />
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0" Orientation="Horizontal" Spacing="0">
                    <Button Click="NewHostButton_Click" TabIndex="1">
                        <Button.Content>
                            <SymbolIcon Symbol="Add" />
                        </Button.Content>
                    </Button>
                    <Button Name="SettingsButton" TabIndex="2" Click="SettingsButton_Click">
                        <Button.Content>
                            <SymbolIcon Symbol="Setting" />
                        </Button.Content>
                    </Button>
                </StackPanel>

            </Grid>
        </Grid>
</Page>
