<Page
    x:Class="moonlight_xbox_dx.MoonlightSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ThemeSecondaryBackgroundColor}">
    
    <Grid Padding="8,16,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="backButton" Click="backButton_Click">
                <Button.Content>
                    <SymbolIcon Symbol="Back" />
                </Button.Content>
            </Button>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="App Settings" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>
            <Button x:Name="WelcomeButton" Grid.Column="2" Click="WelcomeButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,16">Open Welcome Wizard</Button>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource ThemeBackgroundColor}" Margin="75,35" CornerRadius="8">
            <local:TabsLayout x:Name="tabsLayout" Margin="24">

                <local:TabsLayout.TabsContent>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button TabIndex="0" Grid.Row="0" Grid.Column="0" Style="{StaticResource TabButtonStyle}" x:Name="ScreenTab" local:TabsLayout.TargetPanelName="ScreenPanel" Content="Screen" HorizontalAlignment="Stretch"
                                XYFocusDown="{x:Bind InputTab}"
                                XYFocusRight="{x:Bind HostSelector}" />
                        <Button TabIndex="1" Grid.Row="1" Grid.Column="0" Style="{StaticResource TabButtonStyle}" x:Name="InputTab" local:TabsLayout.TargetPanelName="InputPanel" Content="Input" HorizontalAlignment="Stretch"
                                XYFocusDown="{x:Bind ScreenTab}"
                                XYFocusRight="{x:Bind KeyboardEnable}" />
                    </Grid>
                </local:TabsLayout.TabsContent>
                
                <local:TabsLayout.LeftContent>
                    <Grid>

                        <!-- Screen -->

                        <StackPanel x:Name="ScreenPanel" Visibility="Visible">
                            <Border Margin="0,0,0,16" HorizontalAlignment="Stretch" CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemListAccentMediumColor}"/>
                                </Border.Background>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="12,10,12,10" VerticalAlignment="Center">
                                        <Run FontFamily="Segoe Fluent Icons" FontSize="28">&#xe946;</Run>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Margin="4,10,12,10" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextWrapping="Wrap">
                                        Looking to change Resolution, FPS or Bitrate? Use the settings button in the app grid to change the settings of your host.
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="GENERAL" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Autostart Host" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" x:Name="HostSelector" SelectionChanged="HostSelector_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="180" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" x:Name="ThemeToggle" Toggled="ThemeToggle_Toggled" OffContent="Light" OnContent="Dark" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="DISPLAY" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Screen Margin Height" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Value="{x:Bind State.ScreenMarginHeight}" x:DefaultBindMode="TwoWay" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Screen Margin Width" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Value="{x:Bind State.ScreenMarginWidth}" x:DefaultBindMode="TwoWay" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="4,4,0,0" FontSize="12" Opacity="0.5" TextWrapping="Wrap">
                                Change these parameters until you can see a green border around the screen
                            </TextBlock>
                        </StackPanel>


                        <!-- Input -->

                        <StackPanel x:Name="InputPanel" Visibility="Collapsed" Padding="0,0,16,0">
                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="MOUSE" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mouse Sensitivity" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Value="{x:Bind State.MouseSensitivity}" x:DefaultBindMode="TwoWay" HorizontalAlignment="Stretch" Minimum="1" Maximum="16" StepFrequency="1" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="KEYBOARD" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Experimental Keyboard" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{x:Bind State.EnableKeyboard,Mode=TwoWay}" Name="KeyboardEnable" XYFocusRight="{x:Bind KeyboardLayoutSelector}">Enabled</CheckBox>
                                            <ComboBox XYFocusLeft="{x:Bind KeyboardEnable}" x:Name="KeyboardLayoutSelector" SelectionChanged="LayoutSelector_SelectionChanged" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="Layout" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Alternate Menu Combination" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" IsChecked="{x:Bind State.AlternateCombination,Mode=TwoWay}" XYFocusRight="{x:Bind KeyboardLayoutSelector}" VerticalAlignment="Center">Use LT+RT+LB+RB instead of Menu+View to show the menu</CheckBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </local:TabsLayout.LeftContent>
            </local:TabsLayout>
        </Border>
    </Grid>
</Page>
