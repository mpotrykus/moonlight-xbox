<Page
    x:Class="moonlight_xbox_dx.MoonlightSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Page.Resources>
        <Storyboard x:Name="ShowMarginPreview">
            <DoubleAnimation Storyboard.TargetName="ScreenMarginPreviewBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15" />
        </Storyboard>
        <Storyboard x:Name="HideMarginPreview">
            <DoubleAnimation Storyboard.TargetName="ScreenMarginPreviewBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.15" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <local:DynamicBackgroundHost x:Name="BackgroundHost"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     IsHitTestVisible="False" />

        <Button x:Name="backButton" Click="backButton_Click" BorderThickness="0" Background="Transparent"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" IsTabStop="False" Padding="8">
            <Viewbox Height="16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Foreground="{ThemeResource ButtonForegroundColor}" Text="Back"/>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF094;" Foreground="{ThemeResource ButtonForegroundColor}"/>
                </StackPanel>
            </Viewbox>
        </Button>

        <Grid Padding="24,20,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0" VerticalAlignment="Center">
                <TextBlock Text="Moonlight Settings" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>
            <Button x:Name="WelcomeButton" Grid.Column="1" Style="{StaticResource SettingsButtonStyle}" Click="WelcomeButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" XYFocusDown="{x:Bind ScreenTab}">Open Welcome Wizard</Button>
        </Grid>

        <Border Grid.Row="1" Margin="{StaticResource SettingsPanelMargin}" CornerRadius="16" MaxWidth="{StaticResource SettingsPanelMaxWidth}" MaxHeight="{StaticResource SettingsPanelMaxHeight}"
                BorderBrush="#1EFFFFFF" BorderThickness="1">
            <Border.Background>
                    <AcrylicBrush TintColor="#FFFFFF" TintOpacity="0.04" TintLuminosityOpacity="0.13"/>
                </Border.Background>
            <local:TabsLayout x:Name="tabsLayout" Margin="{StaticResource SettingsPanelInnerMargin}">

                <local:TabsLayout.TabsContent>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button TabIndex="0" Grid.Row="0" Grid.Column="0" Style="{StaticResource TabButtonStyle}" x:Name="ScreenTab" local:TabsLayout.TargetPanelName="ScreenPanel" Content="Screen" HorizontalAlignment="Stretch"
                                XYFocusDown="{x:Bind InputTab}"
                                XYFocusRight="{x:Bind HostSelector}" />
                        <Button TabIndex="1" Grid.Row="1" Grid.Column="0" Style="{StaticResource TabButtonStyle}" x:Name="InputTab" local:TabsLayout.TargetPanelName="InputPanel" Content="Input" HorizontalAlignment="Stretch"
                                XYFocusDown="{x:Bind ScreenTab}"
                                XYFocusRight="{x:Bind KeyboardEnable}" />
                    </Grid>
                </local:TabsLayout.TabsContent>
                
                <local:TabsLayout.LeftContent>
                    <Grid>

                        <!-- Screen -->

                        <StackPanel x:Name="ScreenPanel" Visibility="Visible">
                            <Border Margin="0,0,0,16" HorizontalAlignment="Stretch" CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemListAccentMediumColor}"/>
                                </Border.Background>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="12,10,12,10" VerticalAlignment="Center">
                                        <Run FontFamily="Segoe Fluent Icons" FontSize="28">&#xe946;</Run>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Margin="4,10,12,10" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextWrapping="Wrap">
                                        Looking to change Resolution, FPS or Bitrate? Use the settings button in the app grid to change the settings of your host.
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="GENERAL" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Autostart Host" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="HostSelector" SelectionChanged="HostSelector_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="180" XYFocusLeft="{x:Bind ScreenTab}" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="DISPLAY" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <Grid RowSpacing="{StaticResource SettingsRowSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                        
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Screen Margin Height" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Grid.Row="0" Value="{x:Bind State.ScreenMarginHeight}" x:DefaultBindMode="TwoWay" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                            ValueChanged="OnMarginSliderChanged"
                                            GotFocus="OnMarginSliderGotFocus"
                                            LostFocus="OnMarginSliderLostFocus"
                                            XYFocusLeft="{x:Bind ScreenTab}" />

                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Screen Margin Width" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Grid.Row="1" Value="{x:Bind State.ScreenMarginWidth}" x:DefaultBindMode="TwoWay" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                            ValueChanged="OnMarginSliderChanged"
                                            GotFocus="OnMarginSliderGotFocus"
                                            LostFocus="OnMarginSliderLostFocus"
                                            XYFocusLeft="{x:Bind ScreenTab}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="4,4,0,0" FontSize="12" Opacity="0.5" TextWrapping="Wrap">
                                Change these parameters until you can see a border around the screen
                            </TextBlock>
                        </StackPanel>

                        <!-- Input -->

                        <StackPanel x:Name="InputPanel" Visibility="Collapsed" Padding="0,0,16,0">
                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="MOUSE" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mouse Sensitivity" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Value="{x:Bind State.MouseSensitivity}" x:DefaultBindMode="TwoWay" HorizontalAlignment="Stretch" Minimum="1" Maximum="16" StepFrequency="1" VerticalAlignment="Center" XYFocusLeft="{x:Bind InputTab}" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="KEYBOARD" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <Grid RowSpacing="{StaticResource SettingsRowSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                        
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Experimental Keyboard" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{x:Bind State.EnableKeyboard,Mode=TwoWay}"
                                                  Name="KeyboardEnable"
                                                  FontSize="12"
                                                  Margin="0,0,20,0"
                                                  XYFocusLeft="{x:Bind InputTab}"
                                                  XYFocusRight="{x:Bind KeyboardLayoutSelector}">Enabled</CheckBox>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox XYFocusLeft="{x:Bind KeyboardEnable}" 
                                                      x:Name="KeyboardLayoutSelector" 
                                                      SelectionChanged="LayoutSelector_SelectionChanged" 
                                                      HorizontalAlignment="Stretch" />
                                            <TextBlock Text="Layout" 
                                                       FontSize="12"
                                                       VerticalAlignment="Center" 
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                        
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Alternate Menu Combination" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Grid.Row="1"
                                              IsChecked="{x:Bind State.AlternateCombination,Mode=TwoWay}"
                                              XYFocusLeft="{x:Bind InputTab}"
                                              XYFocusRight="{x:Bind KeyboardLayoutSelector}"
                                              FontSize="12"
                                              VerticalAlignment="Center">
                                        Use LT+RT+LB+RB instead of Menu+View to show the menu
                                    </CheckBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </local:TabsLayout.LeftContent>
            </local:TabsLayout>
        </Border>
        </Grid>

        <Border x:Name="ScreenMarginPreviewBorder"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="2"
                Background="Transparent"
                Opacity="0"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
    </Grid>
</Page>
