<UserControl
    x:Class="moonlight_xbox_dx.MoonBackground"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Canvas x:Name="SkyCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                SizeChanged="Canvas_SizeChanged">
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0.5,0.0" EndPoint="0.5,1.0">
                    <GradientStop Color="#77050520" Offset="0.0"/>
                    <GradientStop Color="#770d1a45" Offset="0.5"/>
                    <GradientStop Color="#330a1530" Offset="1.0"/>
                </LinearGradientBrush>
            </Canvas.Background>
        </Canvas>
        <Border>
            <Border.Background>
                <AcrylicBrush TintColor="#000" TintLuminosityOpacity="00.5" TintOpacity="0.0"/>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
